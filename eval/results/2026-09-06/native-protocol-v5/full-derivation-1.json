      "arguments": "{\"code\": \"import math\\n\\n# Solve x² - 5x + 6 = 0 using quadratic formula\\n# ax² + bx + c = 0\\na = 1\\nb = -5\\nc = 6\\n\\n# Discriminant\\ndelta = b**2 - 4*a*c\\nprint(f\\\"判别式 Δ = b² - 4ac = {b}² - 4×{a}×{c} = {delta}\\\")\\n\\n# Solutions\\nif delta >= 0:\\n    x1 = (-b + math.sqrt(delta)) / (2*a)\\n    x2 = (-b - math.sqrt(delta)) / (2*a)\\n    print(f\\\"x₁ = (-b + √Δ) / 2a = ({-b} + √{delta}) / {2*a} = {x1}\\\")\\n    print(f\\\"x₂ = (-b - √Δ) / 2a = ({-b} - √{delta}) / {2*a} = {x2}\\\")\\nelse:\\n    print(\\\"无实数解\\\")\"}"
